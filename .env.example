# Gemini API Key for the serverless backend (api/ai/ask.ts and api/ai/analyze.ts)
GEMINI_API_KEY=your_gemini_api_key_here

# API URL for the Expo app (src/services/ai.ts)
# Defaults to http://localhost:3000 if not specified.
# - If testing on iOS Simulator / Web: http://localhost:3000
# - If testing on Android Emulator: http://10.0.2.2:3000
# - If testing on a physical device: http://<your-computer-local-ip>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
